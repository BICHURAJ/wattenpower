# Settings for the api container. Copy this file to docker.env (git-ignored)
# and fill it in. NODE_ENV, PORT and TRUST_PROXY are set in docker-compose.yml.

# MongoDB is outside Docker. host.docker.internal is this machine as seen from
# the container; MongoDB must accept connections from it (see README).
# For MongoDB Atlas use its address instead: mongodb+srv://<user>:<password>@<cluster>/watten_power
MONGODB_URI=mongodb://host.docker.internal:27017/watten_power

# Required. At least 32 bytes of random data, different from your dev .env:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# The address people open the app at (exact, no trailing slash).
CORS_ALLOWED_ORIGINS=http://localhost:8080
