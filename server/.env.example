MONGODB_URI=mongodb://127.0.0.1:27017/watten_power
PORT=4000

# Required. Signs login tokens. At least 32 bytes of random data -- never a
# made-up word. Generate your own (each environment gets a different one):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to start if this is missing, too short or a placeholder.
JWT_SECRET= 

# Exact origins (scheme://host[:port], comma-separated, no wildcards or trailing
# slashes) allowed to call the API from a browser. Required when
# NODE_ENV=production; in development it defaults to http://localhost:5273.
CORS_ALLOWED_ORIGINS=http://localhost:5273
